# ===== LLM 配置 =====
LLM_PROVIDER=openai          # openai / ollama / deepseek
LLM_MODEL=gpt-4o-mini        # 模型名称
OPENAI_API_KEY=sk-xxx        # OpenAI API Key
OPENAI_BASE_URL=https://api.openai.com/v1  # 自定义 API 地址 (DeepSeek/Moonshot 等)

# ===== Embedding 配置 =====
EMBEDDING_MODEL=text-embedding-3-small     # Embedding 模型
EMBEDDING_DIMENSIONS=1536                  # 向量维度 (仅影响配置，实际由模型决定)

# ===== RAG 配置 =====
CHUNK_SIZE=512               # 文档分块大小 (字符数)
CHUNK_OVERLAP=50             # 分块重叠 (字符数)
RETRIEVAL_TOP_K=5            # 检索 Top-K

# ===== 记忆配置 =====
SHORT_TERM_MAX_TURNS=20      # 短期记忆最大轮数
SUMMARY_INTERVAL=10          # 每 N 轮压缩一次摘要
MEMORY_SEARCH_TOP_K=3        # 长期记忆检索数量

# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ===== 数据路径 =====
VECTOR_DB_PATH=./data/vector_db
DB_PATH=./data/sqlite/agent.db
UPLOAD_DIR=./data/uploads
