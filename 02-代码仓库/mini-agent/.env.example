# Provider: openai or anthropic
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini

# OpenAI compatible provider: OpenAI / DeepSeek / Qwen
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key

# Anthropic native provider
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MAX_TOKENS=1024

# Agent
MAX_ITERATIONS=10
SANDBOX_DIR=data

# Context compression (Stage 4)
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_TOKEN_BUDGET=8192
CONTEXT_RECENT_TURNS=5
CONTEXT_TOOL_OUTPUT_MAX_CHARS=2000
CONTEXT_TOOL_OUTPUT_HEAD_CHARS=1000
CONTEXT_TOOL_OUTPUT_TAIL_CHARS=500
TOOL_TIMEOUT_SECONDS=30

# Legacy model name (still supported)
# LLM_MODEL=gpt-4o-mini